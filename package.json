{
  "name": "@google/genai",
  "version": "2.20.0",
  "description": "",
  "type": "module",
  "sideEffects": [
    "**/sentencepiece_model.pb.js"
  ],
  "main": "./dist/commonjs/node/index.js",
  "module": "./dist/esm/web/index.js",
  "browser": "./dist/esm/web/index.js",
  "typings": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "browser": {
        "import": {
          "types": "./dist/esm/web/index.d.ts",
          "default": "./dist/esm/web/index.js"
        },
        "require": {
          "types": "./dist/commonjs/web/index.d.ts",
          "default": "./dist/commonjs/web/index.js"
        },
        "default": "./dist/esm/web/index.js"
      },
      "node": {
        "import": {
          "types": "./dist/esm/node/index.d.ts",
          "default": "./dist/esm/node/index.js"
        },
        "require": {
          "types": "./dist/commonjs/node/index.d.ts",
          "default": "./dist/commonjs/node/index.js"
        },
        "default": "./dist/esm/node/index.js"
      },
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      },
      "default": "./dist/esm/index.js"
    },
    "./web": {
      "import": {
        "types": "./dist/esm/web/index.d.ts",
        "default": "./dist/esm/web/index.js"
      },
      "require": {
        "types": "./dist/commonjs/web/index.d.ts",
        "default": "./dist/commonjs/web/index.js"
      },
      "default": "./dist/esm/web/index.js"
    },
    "./node": {
      "import": {
        "types": "./dist/esm/node/index.d.ts",
        "default": "./dist/esm/node/index.js"
      },
      "require": {
        "types": "./dist/commonjs/node/index.d.ts",
        "default": "./dist/commonjs/node/index.js"
      },
      "default": "./dist/esm/node/index.js"
    },
    "./tokenizer": {
      "node": {
        "import": {
          "types": "./dist/esm/tokenizer/node.d.ts",
          "default": "./dist/esm/tokenizer/node.js"
        },
        "require": {
          "types": "./dist/commonjs/tokenizer/node.d.ts",
          "default": "./dist/commonjs/tokenizer/node.js"
        },
        "default": "./dist/esm/tokenizer/node.js"
      },
      "import": {
        "types": "./dist/esm/tokenizer/node.d.ts",
        "default": "./dist/esm/tokenizer/node.js"
      },
      "require": {
        "types": "./dist/commonjs/tokenizer/node.d.ts",
        "default": "./dist/commonjs/tokenizer/node.js"
      },
      "default": "./dist/esm/tokenizer/node.js"
    },
    "./tokenizer/node": {
      "import": {
        "types": "./dist/esm/tokenizer/node.d.ts",
        "default": "./dist/esm/tokenizer/node.js"
      },
      "require": {
        "types": "./dist/commonjs/tokenizer/node.d.ts",
        "default": "./dist/commonjs/tokenizer/node.js"
      },
      "default": "./dist/esm/tokenizer/node.js"
    },
    "./vertex_internal": {
      "import": {
        "types": "./dist/esm/vertex_internal/index.d.ts",
        "default": "./dist/esm/vertex_internal/index.js"
      },
      "require": {
        "types": "./dist/commonjs/vertex_internal/index.d.ts",
        "default": "./dist/commonjs/vertex_internal/index.js"
      }
    }
  },
  "scripts": {
    "preinstall": "echo 'preinstall: no-op'",
    "prepare": "node scripts/prepare.js",
    "prepack": "echo 'prepack: no-op'",
    "postpack": "echo 'postpack: no-op'",
    "prebuild": "echo 'prebuild: no-op'",
    "clean:dist": "node scripts/clean_output.mjs dist",
    "clean:test": "node scripts/clean_output.mjs dist/test-build",
    "build": "npm run clean:dist && node scripts/ensure_citc_output.mjs && tsc -p tsconfig.esm.json && tsc -p tsconfig.cjs.json && node scripts/finalize-dist.mjs && node scripts/ignore_missing_mcp_dep.js",
    "build:test": "npm run clean:test && tsc -p tsconfig.test.json && cp src/cross/sentencepiece/sentencepiece_model.pb.js dist/test-build/src/cross/sentencepiece/",
    "api-report": "./scripts/build_api_reports.sh",
    "test:package-contract": "node test/packaging/verify_package_contract.mjs",
    "api-extractor:dev:main": "api-extractor run --local --verbose",
    "api-extractor:dev:node": "api-extractor run -c api-extractor.node.json --local --verbose",
    "api-extractor:dev:web": "api-extractor run -c api-extractor.web.json --local --verbose",
    "api-extractor:dev:tokenizer-node": "api-extractor run -c api-extractor.tokenizer-node.json --local --verbose",
    "api-extractor:dev:vertex_internal": "api-extractor run -c api-extractor.vertex_internal.json --local --verbose",
    "unit-test": "npm run build:test && jasmine dist/test-build/test/unit/**/*_test.js dist/test-build/test/unit/**/**/*_test.js dist/test-build/test/unit/*_test.js",
    "system-test": "npm run build:test && jasmine dist/test-build/test/system/**/*_test.js",
    "test-server-tests": "npm run build:test && GOOGLE_CLOUD_PROJECT=googcloudproj GOOGLE_CLOUD_LOCATION=googcloudloc jasmine dist/test-build/test/system/node/*_test.js -- --test-server",
    "test-server-tests:record": "npm run build:test && jasmine --fail-fast dist/test-build/test/system/node/*_test.js -- --test-server --record",
    "docs": "typedoc && node --loader ts-node/esm scripts/add_docsite_license_headers.ts",
    "pages-main": "node --loader ts-node/esm scripts/generate_pages.ts main",
    "pages-release": "node --loader ts-node/esm scripts/generate_pages.ts release",
    "format": "prettier '**/*.ts' '**/*.mjs' '**/*.json' --write",
    "lint": "eslint '**/*.ts'",
    "lint-fix": "eslint --fix '**/*.ts'",
    "coverage-report": "./test/generate_report.sh",
    "generate-proto": "pbjs -t static-module -w es6 -o src/cross/sentencepiece/sentencepiece_model.pb.js src/cross/sentencepiece/sentencepiece_model.proto && pbts -o src/cross/sentencepiece/sentencepiece_model.pb.d.ts src/cross/sentencepiece/sentencepiece_model.pb.js && sed -i.bak 's/import \\* as \\$protobuf from \"protobufjs\\/minimal\"/import \\$protobuf from \"protobufjs\\/minimal.js\"/' src/cross/sentencepiece/sentencepiece_model.pb.js && rm src/cross/sentencepiece/sentencepiece_model.pb.js.bak"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "tmp": "^0.2.4"
  },
  "files": [
    "dist/esm/**",
    "dist/commonjs/**",
    "node/package.json",
    "web/package.json"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@cfworker/json-schema": "^4.1.1",
    "@eslint/js": "9.20.0",
    "@microsoft/api-extractor": "^7.52.9",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@types/jasmine": "^5.1.2",
    "@types/node": "^20.9.0",
    "@types/node-fetch": "^2.6.13",
    "@types/unist": "^3.0.3",
    "@types/ws": "^8.5.14",
    "c8": "^10.1.3",
    "eslint": "8.57.0",
    "gts": "^5.2.0",
    "jasmine": "^5.5.0",
    "jasmine-reporters": "^2.4.0",
    "node-fetch": "^3.3.2",
    "nyc": "^17.1.0",
    "prettier": "3.3.3",
    "prettier-plugin-organize-imports": "^4.1.0",
    "protobufjs-cli": "^1.1.3",
    "publint": "^0.3.24",
    "test-server-sdk": "^0.2.9",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "tsx": "^4.19.4",
    "typedoc": "^0.27.0",
    "typescript": "~5.7.3",
    "typescript-eslint": "8.24.1",
    "undici": "^7.16.0",
    "undici-types": "^7.16.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.0"
  },
  "dependencies": {
    "google-auth-library": "^10.3.0",
    "p-retry": "^4.6.2",
    "protobufjs": "^7.5.4",
    "ws": "^8.18.0"
  },
  "peerDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/sdk": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/googleapis/js-genai.git"
  },
  "bugs": {
    "url": "https://github.com/googleapis/js-genai/issues"
  },
  "homepage": "https://github.com/googleapis/js-genai#readme",
  "author": "",
  "license": "Apache-2.0"
}
