/**
 * Report-only API Extractor configuration for the package's default entry.
 * Entry-specific configurations extend this file and change the report input
 * and name. Declaration rollup and documentation metadata are intentionally
 * disabled; TypeScript's per-file declarations are the published types.
 */
{
  "$schema": "https://developer.microsoft.com/json-schemas/api-extractor/v7/api-extractor.schema.json",

  "mainEntryPointFilePath": "<projectFolder>/dist/esm/index.d.ts",

  "apiReport": {
    "enabled": true,
    "reportFolder": "<projectFolder>/temp/api-report/"
  },

  "docModel": {
    "enabled": false
  },

  "dtsRollup": {
    "enabled": false
  },

  "tsdocMetadata": {
    "enabled": false
  },

  "messages": {
    "compilerMessageReporting": {
      "default": {
        "logLevel": "warning"
      }
    },
    "extractorMessageReporting": {
      "default": {
        "logLevel": "warning"
      },
      "ae-missing-release-tag": {
        "logLevel": "none"
      }
    },
    "tsdocMessageReporting": {
      "default": {
        "logLevel": "none"
      }
    }
  }
}
